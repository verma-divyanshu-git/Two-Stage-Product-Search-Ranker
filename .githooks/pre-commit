#!/bin/sh
# Only Divyanshu's personal account may commit here.
NAME="Divyanshu"
EMAIL="bautocrats@gmail.com"
WANT="$NAME <$EMAIL>"

for var in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    got=$(git var "$var" | sed 's/ [0-9]* [-+][0-9]*$//')
    if [ "$got" != "$WANT" ]; then
        echo "pre-commit: $var is '$got', expected '$WANT'" >&2
        exit 1
    fi
done
